<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon />
    <AssemblyName>برنامه قانونی و مجوزدار سفارشی دولت</AssemblyName>
    <RootNamespace>GovernmentMiningApp</RootNamespace>
    <Version>1.0.0</Version>
    <Product>برنامه قانونی و مجوزدار سفارشی دولت</Product>
    <Description>سیستم مدیریت عملیات ردیابی و ثبت دستگاه‌های ماینر — نسخه دولتی</Description>
    <Company>Government Authorized Edition</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ForceDesignerDpiUnaware>false</ForceDesignerDpiUnaware>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\schema.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
