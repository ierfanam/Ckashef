<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon />
    <AssemblyName>سامانه ردیابی دستگاه‌های ماینر</AssemblyName>
    <RootNamespace>GovernmentMiningApp</RootNamespace>
    <Version>2.0.0</Version>
    <Product>سامانه ردیابی دستگاه‌های ماینر</Product>
    <Description>سامانه ثبت و پیگیری عملیات پروب مجاز دستگاه‌های ماینر — مبتنی بر داده‌های واقعی</Description>
    <Company>Ministry-Affiliated Engineering Unit</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ForceDesignerDpiUnaware>false</ForceDesignerDpiUnaware>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\schema.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
